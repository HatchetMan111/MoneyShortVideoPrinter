[Unit]
Description=MoneyPrinterTurbo Web UI (Streamlit, Proxmox LXC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/moneyprinterturbo/MoneyPrinterTurbo
Environment=PYTHONUNBUFFERED=1
Environment=MPT_WEBUI_HOST=0.0.0.0
Environment=MPT_WEBUI_PORT=8501
ExecStart=/opt/moneyprinterturbo/MoneyPrinterTurbo/.venv/bin/python -m streamlit run /opt/moneyprinterturbo/MoneyPrinterTurbo/webui/Main.py --server.address=0.0.0.0 --server.port=8501 --browser.gatherUsageStats=False --client.toolbarMode=minimal --logger.hideWelcomeMessage=True --server.showEmailPrompt=False --server.enableCORS=True
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
