[Unit]
Description=MoneyShortVideoPrinter API (FastAPI, Proxmox LXC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/moneyshortvideoprinter/MoneyPrinterTurbo
Environment=PYTHONUNBUFFERED=1
# Bind (0.0.0.0:8080) kommt aus /opt/moneyshortvideoprinter/MoneyPrinterTurbo/config.toml
# (listen_host/listen_port, wird von setup-container.sh idempotent gepatcht).
ExecStart=/opt/moneyshortvideoprinter/MoneyPrinterTurbo/.venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
